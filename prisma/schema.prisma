generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                        String                    @id @default(cuid())
  userId                    String                    @unique
  name                      String?
  email                     String?                   @unique
  emailVerified             DateTime?
  passwordHash              String?
  image                     String?
  bio                       String?
  statusMessage             String?
  presenceStatus            UserPresenceStatus        @default(ONLINE)
  sessionVersion            Int                       @default(0)
  lastSeenAt                DateTime?
  matchingRatingTotal       Int                       @default(0)
  matchingRatingCount       Int                       @default(0)
  accounts                  Account[]
  attachments               MessageAttachment[]
  blockedBy                 UserBlock[]               @relation("BlockedUsers")
  blockedUsers              UserBlock[]               @relation("UserBlocks")
  channelReads              ServerChannelRead[]
  createdGroupConversations GroupConversation[]       @relation("CreatedGroupConversations")
  receivedDirectMessages    DirectMessage[]           @relation("ReceivedDirectMessages")
  createdServers            ChatServer[]              @relation("CreatedServers")
  friendships               Friendship[]              @relation("UserFriendships")
  friendOf                  Friendship[]              @relation("FriendOf")
  matchingQueue             MatchingQueue?
  matchingResultsAsFirst    MatchingResult[]          @relation("FirstMatchedUser")
  matchingResultsAsSecond   MatchingResult[]          @relation("SecondMatchedUser")
  matchingTopicProfiles     MatchingTopicProfile[]
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  pushSubscriptions         PushSubscription[]
  groupMemberships          GroupConversationMember[]
  sentGroupMessages         GroupMessage[]            @relation("SentGroupMessages")
  directMessageReactions    DirectMessageReaction[]
  serverMessageReactions    ServerMessageReaction[]
  groupMessageReactions     GroupMessageReaction[]
  savedDirectMessages       SavedDirectMessage[]
  savedServerMessages       SavedServerMessage[]
  savedGroupMessages        SavedGroupMessage[]
  reportedMessages          MessageReport[]           @relation("ReportedUsers")
  reviewedReports           MessageReport[]           @relation("ReviewedReports")
  submittedReports          MessageReport[]           @relation("SubmittedReports")
  sentServerMessages        ServerMessage[]           @relation("SentServerMessages")
  sentDirectMessages        DirectMessage[]           @relation("SentDirectMessages")
  receivedFriendRequests    FriendRequest[]           @relation("ReceivedFriendRequests")
  serverMemberships         ServerMember[]
  sentFriendRequests        FriendRequest[]           @relation("SentFriendRequests")
  sessions                  Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model PendingRegistration {
  email        String   @id
  token        String   @unique
  userId       String
  name         String
  passwordHash String
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([expires])
  @@index([userId])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model ChatEvent {
  id          BigInt   @id @default(autoincrement())
  kind        String
  payload     Json
  audienceIds String[]
  serverId    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([serverId, id])
  @@index([audienceIds], type: Gin)
}

model FriendRequest {
  id            String              @id @default(cuid())
  senderId      String
  receiverId    String
  status        FriendRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  notifications Notification[]
  receiver      User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender        User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  friend    User     @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)
  user      User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  type            NotificationType
  message         String
  friendRequestId String?
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  friendRequest   FriendRequest?   @relation(fields: [friendRequestId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  userId             String   @id
  directMessages     Boolean  @default(true)
  groupMessages      Boolean  @default(true)
  mentions           Boolean  @default(true)
  friendRequests     Boolean  @default(true)
  matching           Boolean  @default(true)
  showMessagePreview Boolean  @default(false)
  quietHoursStart    Int?
  quietHoursEnd      Int?
  timeZone           String?
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id             String    @id @default(cuid())
  userId         String
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DirectMessage {
  id          String                  @id @default(cuid())
  clientId    String?
  content     String
  createdAt   DateTime                @default(now())
  readAt      DateTime?
  receiverId  String
  senderId    String
  replyToId   String?
  receiver    User                    @relation("ReceivedDirectMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      User                    @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo     DirectMessage?          @relation("DirectMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     DirectMessage[]         @relation("DirectMessageReplies")
  reactions   DirectMessageReaction[]
  attachments MessageAttachment[]
  savedBy     SavedDirectMessage[]

  @@unique([senderId, clientId])
  @@index([receiverId, readAt, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([senderId, receiverId, createdAt])
  @@index([replyToId])
}

model DirectMessageReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime      @default(now())
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([userId, createdAt])
}

model SavedDirectMessage {
  userId    String
  messageId String
  createdAt DateTime      @default(now())
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
  @@index([userId, createdAt])
}

model GroupConversation {
  id          String                    @id @default(cuid())
  name        String?
  createdById String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  createdBy   User                      @relation("CreatedGroupConversations", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupConversationMember[]
  messages    GroupMessage[]

  @@index([createdById, updatedAt])
}

model GroupConversationMember {
  groupId   String
  userId    String
  role      GroupMemberRole   @default(MEMBER)
  readAt    DateTime          @default(now())
  createdAt DateTime          @default(now())
  group     GroupConversation @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, createdAt])
}

model GroupMessage {
  id          String                 @id @default(cuid())
  clientId    String?
  content     String
  groupId     String
  senderId    String
  replyToId   String?
  createdAt   DateTime               @default(now())
  group       GroupConversation      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender      User                   @relation("SentGroupMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo     GroupMessage?          @relation("GroupMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     GroupMessage[]         @relation("GroupMessageReplies")
  reactions   GroupMessageReaction[]
  attachments MessageAttachment[]
  savedBy     SavedGroupMessage[]

  @@unique([senderId, clientId])
  @@index([groupId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToId])
}

model GroupMessageReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime     @default(now())
  message   GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([userId, createdAt])
}

model SavedGroupMessage {
  userId    String
  messageId String
  createdAt DateTime     @default(now())
  message   GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
  @@index([userId, createdAt])
}

model MatchingQueue {
  id               String          @id @default(cuid())
  userId           String          @unique
  topic            MatchingTopic
  matchedUserId    String?
  matchingResultId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchingResult   MatchingResult? @relation(fields: [matchingResultId], references: [id], onDelete: SetNull)

  @@index([topic, matchedUserId, createdAt])
  @@index([matchingResultId])
}

model MatchingResult {
  id                            String          @id @default(cuid())
  firstUserId                   String
  secondUserId                  String
  topic                         MatchingTopic
  firstUserRatedAt              DateTime?
  secondUserRatedAt             DateTime?
  firstUserRating               MatchingRating?
  secondUserRating              MatchingRating?
  firstUserConversationConsent  Boolean?
  secondUserConversationConsent Boolean?
  firstUserChatConsentAt        DateTime?
  secondUserChatConsentAt       DateTime?
  createdAt                     DateTime        @default(now())
  firstUser                     User            @relation("FirstMatchedUser", fields: [firstUserId], references: [id], onDelete: Cascade)
  secondUser                    User            @relation("SecondMatchedUser", fields: [secondUserId], references: [id], onDelete: Cascade)
  queues                        MatchingQueue[]
  rematchRequest                RematchRequest?

  @@index([firstUserId, firstUserRatedAt, createdAt])
  @@index([secondUserId, secondUserRatedAt, createdAt])
  @@index([firstUserId, createdAt, id])
  @@index([secondUserId, createdAt, id])
}

model RematchRequest {
  id                    String               @id @default(cuid())
  matchingResultId      String               @unique
  firstUserRequestedAt  DateTime?
  secondUserRequestedAt DateTime?
  status                RematchRequestStatus @default(PENDING)
  expiresAt             DateTime
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  matchingResult        MatchingResult       @relation(fields: [matchingResultId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

model MatchingTopicProfile {
  userId      String
  topic       MatchingTopic
  vector      Json
  sampleCount Int
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topic])
  @@index([topic, updatedAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ChatServer {
  id          String           @id @default(cuid())
  name        String
  description String?
  image       String?
  inviteCode  String           @unique @default(cuid())
  visibility  ServerVisibility @default(PRIVATE)
  category    ServerCategory?
  tags        String[]         @default([])
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation("CreatedServers", fields: [createdById], references: [id], onDelete: Cascade)
  channels    ServerChannel[]
  members     ServerMember[]
  messages    ServerMessage[]

  @@index([createdById])
  @@index([visibility, category, createdAt])
}

model ServerMember {
  id        String           @id @default(cuid())
  serverId  String
  userId    String
  role      ServerMemberRole @default(MEMBER)
  nickname  String?
  bio       String?
  createdAt DateTime         @default(now())
  server    ChatServer       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
}

model ServerChannel {
  id        String              @id @default(cuid())
  serverId  String
  name      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  reads     ServerChannelRead[]
  server    ChatServer          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages  ServerMessage[]

  @@unique([serverId, name])
  @@index([serverId, createdAt])
}

model ServerChannelRead {
  id        String        @id @default(cuid())
  channelId String
  userId    String
  readAt    DateTime      @default(now())
  channel   ServerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model ServerMessage {
  id          String                  @id @default(cuid())
  clientId    String?
  content     String
  createdAt   DateTime                @default(now())
  pinnedAt    DateTime?
  channelId   String?
  serverId    String
  senderId    String
  replyToId   String?
  channel     ServerChannel?          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender      User                    @relation("SentServerMessages", fields: [senderId], references: [id], onDelete: Cascade)
  server      ChatServer              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  replyTo     ServerMessage?          @relation("ServerMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ServerMessage[]         @relation("ServerMessageReplies")
  reactions   ServerMessageReaction[]
  attachments MessageAttachment[]
  savedBy     SavedServerMessage[]

  @@unique([senderId, clientId])
  @@index([channelId, createdAt])
  @@index([serverId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToId])
}

model ServerMessageReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime      @default(now())
  message   ServerMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([userId, createdAt])
}

model SavedServerMessage {
  userId    String
  messageId String
  createdAt DateTime      @default(now())
  message   ServerMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
  @@index([userId, createdAt])
}

model MessageAttachment {
  id              String         @id @default(cuid())
  uploaderId      String
  kind            AttachmentKind
  fileName        String
  mimeType        String
  size            Int
  data            Bytes?
  externalUrl     String?
  directMessageId String?
  serverMessageId String?
  groupMessageId  String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  uploader        User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  directMessage   DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  serverMessage   ServerMessage? @relation(fields: [serverMessageId], references: [id], onDelete: Cascade)
  groupMessage    GroupMessage?  @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)

  @@index([uploaderId, createdAt])
  @@index([directMessageId])
  @@index([serverMessageId])
  @@index([groupMessageId])
  @@index([expiresAt])
}

model MessageReport {
  id              String       @id @default(cuid())
  reporterId      String?
  reportedUserId  String?
  messageId       String
  messageKind     MessageKind
  reason          ReportReason
  details         String?
  contentSnapshot String
  serverId        String?
  status          ReportStatus @default(OPEN)
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime     @default(now())
  reporter        User?        @relation("SubmittedReports", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser    User?        @relation("ReportedUsers", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reviewedBy      User?        @relation("ReviewedReports", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, messageKind, messageId])
  @@index([reportedUserId, createdAt])
  @@index([serverId, status, createdAt])
  @@index([createdAt])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_REQUEST_ACCEPTED
}

enum UserPresenceStatus {
  ONLINE
  IDLE
  DND
  INVISIBLE
}

enum MatchingTopic {
  CASUAL
  GAME
  WORRIES
}

enum ServerMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  READ_ONLY
}

enum ServerVisibility {
  PRIVATE
  PUBLIC
}

enum ServerCategory {
  COMMUNITY
  GAMES
  STUDY
  HOBBIES
  WELLBEING
  OTHER
}

enum GroupMemberRole {
  OWNER
  MEMBER
}

enum AttachmentKind {
  IMAGE
  PDF
  LINK
}

enum MatchingRating {
  NEGATIVE
  NEUTRAL
  POSITIVE
}

enum RematchRequestStatus {
  PENDING
  MATCHED
  EXPIRED
}

enum MessageKind {
  DIRECT
  SERVER
  GROUP
}

enum ReportReason {
  HARASSMENT
  SELF_HARM
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
}
