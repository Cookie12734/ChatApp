{
  "name": "connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "predev": "prisma migrate deploy",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "mailpit": "docker compose up -d mailpit",
    "mailpit:down": "docker compose down",
    "preview": "next build && next start",
    "start": "next start",
    "test": "node --test src/features/auth/lib/email-normalization.test.mjs src/features/auth/lib/oauth-user-id.test.mjs src/features/auth/lib/redirect-path.test.mjs src/features/auth/lib/session-user.test.mjs src/features/chat/friend-overview.test.mjs src/features/chat/friend-search.test.mjs src/features/chat/message-links.test.mjs src/features/chat/message-page.test.mjs src/features/chat/server/direct-message-permissions.test.mjs src/features/chat/server/matching-permissions.test.mjs src/features/friend/server/blocking.test.mjs src/features/friend/server/friend-request-permissions.test.mjs src/features/profile/presence.test.mjs src/features/profile/server/profile-permissions.test.mjs src/features/server/server/invite-access.test.mjs src/features/server/server/message-permissions.test.mjs src/features/server/server/server-overview.test.mjs src/lib/static-image.test.mjs src/server/chat-events.test.mjs src/server/rate-limit-policy.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.6.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^15.5.20",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^9.0.3",
    "radix-ui": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.19"
    },
    "nodemailer": "$nodemailer"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.13.0"
}
